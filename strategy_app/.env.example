# Separate workspace credential: set a random secret of at least 24 characters.
# Never reuse a provider API key here. Do not paste secrets into a chat or commit them.
STRATEGY_ACCESS_TOKEN=
STRATEGY_LIVE_ENABLED=false
STRATEGY_DEMO_ENABLED=true
STRATEGY_DATA_DIR=strategy_app/.data

# OpenAI-compatible Chat Completions endpoints supporting JSON object responses.
# These STRATEGY_* settings take precedence over existing SMART_*/LLM_* environment variables.
STRATEGY_FRONTIER_BASE_URL=
STRATEGY_FRONTIER_API_KEY=
STRATEGY_FRONTIER_MODEL=
STRATEGY_EXECUTOR_BASE_URL=
STRATEGY_EXECUTOR_API_KEY=
STRATEGY_EXECUTOR_MODEL=

# Native TypeSafe API, not an OpenAI-compatible base URL.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Running existing MiroShark backend. Match the backend's internal key.
MIROSHARK_API_URL=http://127.0.0.1:5001
MIROSHARK_INTERNAL_KEY=
